{
    "manifest_version": 3,
    "name": "MultiTab GPT",
    "version": "1.0",
    "description": "Summarize multiple tabs using GPT API and export the summary easily.",
    "permissions": [
      "tabs",
      "scripting",
      "activeTab",
      "downloads",
      "clipboardWrite",
      "storage"
    ],
    "host_permissions": [
      "<all_urls>"
    ],
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
      }
    },
    "background": {
      "service_worker": "background.js"
    },
    "icons": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
  